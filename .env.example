# Create a key at https://openrouter.ai/settings/keys
# Or connect keys once in the app (saved privately in DATA_DIR/credentials.json).
OPENROUTER_API_KEY=
# Create a Wan API key at https://wanapi.app/settings/apikeys
WAN_API_KEY=
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Maximum lossless original upload size in MB (AI inputs remain limited to 25 MB each).
MAX_UPLOAD_MB=10240
# Optional paths if FFmpeg / ffprobe are not on your PATH.
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe
# Optional stable public HTTPS origin for references on a hosted installation.
# Local installs automatically use a temporary, file-only Cloudflare tunnel.
# REFERENCE_PUBLIC_ORIGIN=https://frame.example.com
# CLOUDFLARED_BIN=/path/to/cloudflared
